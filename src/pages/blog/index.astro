---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/mypic.jpg" />
		<style>
			main {
				width: 860px;
				max-width: calc(100% - 2em);
				font-family: "Gentium Plus", Georgia, serif;
				padding: 0 1em 1em 1em;
			}
			.mini-hero {
				text-align: center;
				padding: 0.2em 0 0.6em 0;
				border-bottom: 2px solid #000;
				margin-bottom: 0.8em;
			}
			.mini-hero a {
				text-decoration: none;
				color: #000;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.8em;
			}
			.mini-hero img {
				width: 112px;
				height: 112px;
				object-fit: cover;
				border-radius: 0;
				border: 2px solid #000;
				box-shadow: none;
				background: #fff;
				display: block;
			}
			.mini-hero h1 {
				font-size: 1.7em;
				margin: 0;
				color: #000;
				line-height: 1.1;
			}
			ul {
				display: block;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				border: 1px solid #000;
				border-radius: 0;
				background: #fff;
				box-shadow: none;
				margin: 0 0 1em 0;
				padding: 0;
			}
			ul li * {
				text-decoration: none;
			}
			ul li img {
				margin-bottom: 0;
				border-radius: 0;
				border-bottom: 1px solid #000;
				width: 100%;
				height: auto;
				display: block;
			}
			ul li a {
				display: block;
				color: #000;
			}
			.text {
				padding: 0.9em 1em;
			}
			.title {
				margin: 0 0 0.25em 0;
				color: #000;
				line-height: 1.3;
				font-size: 1.3em;
			}
			.date {
				margin: 0;
				color: #000;
				font-size: 0.95em;
			}
			ul li a:hover .title {
				text-decoration: underline;
			}
			@media (max-width: 720px) {
				main {
					padding: 1.2em 1em 1.8em 1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="mini-hero">
				<a href="/" aria-label="Go to home">
					<img src="/mypic.jpg" alt="Portrait of M A Rahman" width="220" height="220" />
					<h1>M A Rahman</h1>
				</a>
			</div>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<img width={720} height={360} src={post.data.heroImage} alt="" />
									<div class="text">
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
