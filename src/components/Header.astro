---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="internal-links">
			<HeaderLink href="/blog">My Blog</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #fff;
		border-bottom: none;
		box-shadow: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-height: 0;
	}
	nav a {
		padding: 0.45em 0.5em;
		color: #000;
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-family: "Gentium Plus", Georgia, serif;
		font-size: 1em;
		line-height: 1.2;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: #000;
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
</style>
